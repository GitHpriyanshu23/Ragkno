# ==============================================================================
# RagKno Production Environment Configuration
# ==============================================================================

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# AgentRouter (primary LLM provider)
AGENTROUTER_API_KEY=your_agentrouter_api_key_here
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=deepseek-v4-flash
AGENTROUTER_FALLBACK_MODELS=gpt-5.5
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_PROVIDER=agentrouter

# Optional Google AI Studio fallback configuration
GOOGLE_API_KEY=your_google_gemini_api_key_here
GOOGLE_LLM_MODEL=gemini-2.5-flash

# Google OAuth (App Sign-In & Google Drive)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_APP_REDIRECT_URI=https://your-backend-domain.com/login/google/callback
GOOGLE_REDIRECT_URI=https://your-backend-domain.com/auth/callback

# Deployment URLs & CORS
FRONTEND_URL=https://your-frontend-domain.com
CORS_ORIGINS=https://your-frontend-domain.com
RAGKNO_SESSION_SECRET=generate_a_secure_random_32_character_string_here
ENV=production

# (Optional) Semantic Reranker & Port
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
PORT=8000
