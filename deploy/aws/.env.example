# Copy to .env in this directory. Never commit the populated file.
# A hostname you control, with an A record pointing to the EC2 public IP.
BACKEND_DOMAIN=api.your-domain.example

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
RAGKNO_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FRONTEND_URL=https://ragkno.pages.dev
CORS_ORIGINS=https://ragkno.pages.dev

LLM_PROVIDER=google
GOOGLE_API_KEY=REPLACE_WITH_YOUR_GOOGLE_AI_STUDIO_KEY
GOOGLE_LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
LLM_AGENTROUTER_FALLBACK_ENABLED=true
AGENTROUTER_API_KEY=REPLACE_WITH_YOUR_KEY
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=deepseek-v4-flash
AGENTROUTER_FALLBACK_MODELS=gpt-5.5
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_REQUEST_TIMEOUT_SECONDS=45
RAG_EMBEDDING_DEVICE=cpu
RAG_RERANKER_DEVICE=cpu
RAG_RERANKER_BATCH_SIZE=8

# Required if enabling Google sign-in / Drive. Register these exact callback URLs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_APP_REDIRECT_URI=https://ragkno.pages.dev/api/login/google/callback
GOOGLE_REDIRECT_URI=https://ragkno.pages.dev/api/auth/callback
